FROM apache/airflow:2.9.3

USER airflow

RUN python3 -m venv /home/airflow/tools-venv \
 && /home/airflow/tools-venv/bin/pip install --no-cache-dir \
    dbt-core==1.8.* \
    dbt-databricks==1.8.*

# Modern Databricks CLI (Go-based) -- NOT the pip "databricks-cli" package,
# which is the legacy client and doesn't handle Volumes paths / host env
# vars correctly. Installs to /usr/local/bin, which needs root.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends unzip \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL https://raw.githubusercontent.com/databricks/setup-cli/main/install.sh | sh
USER airflow

RUN pip install --no-cache-dir \
    faker \
    kafka-python